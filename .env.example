# Configuração do projeto Firebase da JULLY BURGUER
# 1. Vá em https://console.firebase.google.com → crie um projeto novo (ex: "jully-burguer")
# 2. Ative o Firestore Database (modo produção)
# 3. Em Configurações do projeto → Seus apps → adicione um app Web (</>) 
# 4. Copie os valores do "firebaseConfig" mostrado e cole abaixo
# 5. Copie este arquivo para ".env" (sem o ".example") e preencha
# 6. NUNCA suba o arquivo ".env" pro GitHub (ele já está no .gitignore)

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
